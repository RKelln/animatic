# generated build output (local previews, media-absolute, machine-made)
out/

# python
__pycache__/
*.pyc

# E3: alternate-theme build dirs (--theme lecture etc.)
**/out-*/

# agent scratch: plans and notes that live with the workspace, not the code
.hermes/

# a browser test killed mid-run leaves its Chromium profile
waypoint-profile-*/

# build.py --watch: which watcher owns an --out
.*.watch.pid
